{
  "pythonVersion": "3.12",
  "typeCheckingMode": "basic",
  "reportMissingImports": "none",
  "reportMissingTypeStubs": "none",
  "executionEnvironments": [
    {
      "root": "backend",
      "extraPaths": ["backend"],
      "venvPath": "backend",
      "venv": "venv"
    }
  ],
  "exclude": ["**/node_modules", "**/__pycache__", "backend/venv"]
}

